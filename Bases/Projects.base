filters:
  and:
    - file.inFolder("Develop")
    - type == "project"
views:
  - type: table
    name: All Projects
    order:
      - file.name
      - done
      - rate
      - tags
      - file.backlinks
      - file.links
    sort:
      - property: done
        direction: ASC
      - property: rate
        direction: DESC
    columnSize:
      note.rate: 177
      file.backlinks: 387
  - type: table
    name: JS/TS/HTML
    filters:
      and:
        - file.hasTag("javascripts")
    order:
      - file.name
      - done
      - tags
      - rate
      - file.backlinks
      - file.links
    sort:
      - property: done
        direction: ASC
      - property: rate
        direction: DESC
  - type: table
    name: Swift
    filters:
      and:
        - file.hasTag("swift")
    order:
      - file.name
      - done
      - tags
      - rate
      - file.backlinks
      - file.links
    sort:
      - property: done
        direction: ASC
      - property: rate
        direction: DESC
