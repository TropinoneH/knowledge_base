filters:
  and:
    - file.inFolder("Paper")
    - type == "paper"
views:
  - type: table
    name: All Papers
    groupBy:
      property: rate
      direction: DESC
    order:
      - aliases
      - file.name
      - file.tags
      - publish
      - rate
      - done
      - pdf
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.tags: 357
      note.publish: 91
      note.rate: 83
      note.done: 65
